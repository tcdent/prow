#!/bin/bash
# prow-sql: SQL over a prow server's runs (its POST /api/sql), printed as a table.
#   prow-sql                           list projects
#   prow-sql <project> "<SQL>"         one query over every run of the project
#   prow-sql <project> <run> "<SQL>"   one query over one run's files (faster: by its id)
#   prow-sql <project> < query.sql     the SQL from stdin
#
# Views: `runs` (one row per run: its manifest, every attribute a column) and one view per site
# (`step`, `zones`, `plots`, `messages`, ...) with `ts` (UTC), `run` and the site's fields. Join a
# site to `runs` on `run`. A field absent from a run's schema reads NULL in that run's rows.
# `queries` is the server's query log. Only SELECT statements are run, for at most 60 s; the
# server reads its data directory and nothing else.
#
# PROW_URL: the server's HTTP side, e.g. http://10.0.0.2:7381 (no default).
set -euo pipefail
URL=${PROW_URL:?set PROW_URL to the prow server, e.g. http://10.0.0.2:7381}
if [ $# -eq 0 ]; then
    curl -fsS "$URL/api/index" | python3 -c 'import sys, json; [print(p["name"]) for p in json.load(sys.stdin)["projects"]]'
    exit 0
fi
project=$1; shift
run=""
if [ $# -ge 2 ]; then run=$1; shift; fi
if [ $# -ge 1 ]; then sql=$1; else sql=$(cat); fi
curl -sS --fail-with-body -X POST --data-binary "$sql" -H 'Content-Type: text/plain' -H 'X-Prow-Source: prow-sql' \
    "$URL/api/sql?project=$project&run=$run&format=text"
